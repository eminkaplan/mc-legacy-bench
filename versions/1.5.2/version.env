# Minecraft 1.5.2 (2013-04-25): LWJGL 2.9.0, integrated server since 1.3, chunk building on the main thread.
JAVAS="8 21"          # Java versions the suite runs; Java 9+ needs the libjawt shim (LWJGL 2)
JAWT_SHIM=1
UNSIGN=0              # client.jar is not signed
JAVAC_RELEASE=8

bench_options() {     # $1 = normal|far -> options.txt
    cat <<OPT
music:0.0
sound:0.0
viewDistance:$([ "$1" = far ] && echo 0 || echo 1)
fpsLimit:0
enableVsync:false
fancyGraphics:true
pauseOnLostFocus:false
snooperEnabled:false
OPT
}

bench_args() {        # main class + arguments; $G = game dir, $V = version work dir
    echo Bench Bench -
}
