# Minecraft 1.18.2 (2022-02-28): needs Java 17; taller world (y -64..320) and new terrain since 1.18, simulation
# distance separate from render distance (set equal here to match older versions). Harness = common/modern.
JAVAS="17 21"
MODERN=1
JAVAC_RELEASE=17

bench_options() {
    local d; d=$([ "$1" = far ] && echo 16 || echo 8)
    cat <<OPT
renderDistance:$d
simulationDistance:$d
maxFps:260
enableVsync:false
graphicsMode:1
pauseOnLostFocus:false
fullscreen:false
soundCategory_master:0.0
tutorialStep:none
skipMultiplayerWarning:true
realmsNotifications:false
joinedFirstServer:true
narrator:0
OPT
}

bench_args() {
    echo bench.Bench --username Bench --version 1.18.2 --gameDir "$G" --assetsDir "$V/assets" --assetIndex 1.18 \
        --uuid 00000000000000000000000000000000 --accessToken 0 --userType legacy --versionType release --width 854 --height 480
}
