# Minecraft 26.3 (2026-09-15): latest release at the time of writing; needs Java 25, LWJGL 3.4, and ships unobfuscated
# (no mappings needed). Screen and overlay live in Gui; worlds are created through WorldOpenFlows. Harness = common/modern.
JAVAS="25"
MODERN=1
WINDOW_API=sdl     # 26.x replaced GLFW with SDL3
JAVAC_RELEASE=25
# Graphics backends to compare (preferredGraphicsBackend). On X11/XWayland the OpenGL backend only starts when SDL
# uses EGL: without SDL_VIDEO_FORCE_EGL it fails ("Could not retrieve OpenGL functions") and silently falls back to Vulkan.
VARIANTS="opengl vulkan"
RUN_ENV="SDL_VIDEO_DRIVER=x11 SDL_VIDEO_FORCE_EGL=1"
# inactivityFpsLimit defaults to "afk" (1.21.2+): with input locked the player counts as AFK after 30 s and FPS drops
# to 30, so it is set to "minimized".

bench_options() {   # $1 = normal|far, $2 = variant (graphics backend)
    local d; d=$([ "$1" = far ] && echo 16 || echo 8)
    cat <<OPT
version:5023
renderDistance:$d
simulationDistance:$d
maxFps:260
enableVsync:false
inactivityFpsLimit:"minimized"
graphicsPreset:"fancy"
preferredGraphicsBackend:"$2"
pauseOnLostFocus:false
fullscreen:false
soundCategory_master:0.0
tutorialStep:none
skipMultiplayerWarning:true
realmsNotifications:false
joinedFirstServer:true
onboardAccessibility:false
narrator:0
OPT
}

bench_args() {
    echo bench.Bench --username Bench --version 26.3 --gameDir "$G" --assetsDir "$V/assets" --assetIndex 34 \
        --uuid 00000000000000000000000000000000 --accessToken 0 --userType legacy --versionType release --width 854 --height 480
}
