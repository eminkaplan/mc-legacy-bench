# Minecraft 1.14.4 (2019-07-19): LWJGL 3.2.2; new lighting engine and chunk system, first version with official mappings.
# Harness = common/modern + Mojang's official mappings.
JAVAS="8 21"
MODERN=1
JAVAC_RELEASE=8

bench_options() {
    cat <<OPT
renderDistance:$([ "$1" = far ] && echo 16 || echo 8)
maxFps:260
enableVsync:false
fancyGraphics:true
pauseOnLostFocus:false
fullscreen:false
soundCategory_master:0.0
tutorialStep:none
skipMultiplayerWarning:true
realmsNotifications:false
joinedFirstServer:true
narrator:0
OPT
}

bench_args() {
    echo bench.Bench --username Bench --version 1.14.4 --gameDir "$G" --assetsDir "$V/assets" --assetIndex 1.14 \
        --uuid 00000000000000000000000000000000 --accessToken 0 --userType legacy --versionType release --width 854 --height 480
}
