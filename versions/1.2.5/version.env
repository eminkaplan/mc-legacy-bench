# Minecraft 1.2.5 (2012-03-29): LWJGL 2.9.0 (as served by Mojang today); no integrated server yet, the world is
# generated inside the client. Anvil world format since 1.2.
JAVAS="8 21"
JAWT_SHIM=1
UNSIGN=0
JAVAC_RELEASE=8

bench_options() {     # viewDistance: 0 = Far (16 chunks), 1 = Normal (8 chunks)
    cat <<OPT
music:0.0
sound:0.0
viewDistance:$([ "$1" = far ] && echo 0 || echo 1)
fpsLimit:0
fancyGraphics:true
OPT
}

bench_args() {
    echo Bench Bench -
}
