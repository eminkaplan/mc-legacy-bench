# Minecraft 1.12.2 (2017-09-18): LWJGL 2.9.4, the last LWJGL 2 version and the long-lived modding base.
JAVAS="8 21"
JAWT_SHIM=1
UNSIGN=1              # client.jar is signed by Mojang; the harness shares its default package
JAVAC_RELEASE=8

bench_options() {
    cat <<OPT
renderDistance:$([ "$1" = far ] && echo 16 || echo 8)
maxFps:260
enableVsync:false
fancyGraphics:true
pauseOnLostFocus:false
snooperEnabled:false
soundCategory_master:0.0
tutorialStep:none
OPT
}

bench_args() {
    echo Bench --username Bench --version 1.12.2 --gameDir "$G" --assetsDir "$V/assets" --assetIndex 1.12 \
        --uuid 00000000000000000000000000000000 --accessToken 0 --userProperties {} --userType legacy --width 854 --height 480
}
