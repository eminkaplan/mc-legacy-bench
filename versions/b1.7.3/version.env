# Minecraft Beta 1.7.3 (2011-07-07): the last Beta before 1.0 and a nostalgia favourite; LWJGL 2.9.0 (as served by
# Mojang today), no integrated server, McRegion world format.
JAVAS="8 21"
JAWT_SHIM=1
UNSIGN=0
JAVAC_RELEASE=8

bench_options() {     # viewDistance: 0 = Far (16 chunks), 1 = Normal (8 chunks)
    cat <<OPT
music:0.0
sound:0.0
viewDistance:$([ "$1" = far ] && echo 0 || echo 1)
fpsLimit:0
fancyGraphics:true
OPT
}

bench_args() {
    echo Bench Bench -
}
